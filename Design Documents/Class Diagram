classDiagram
    Database <|-- Timetable
    Database <|-- ModuleDatabase
    Timetable -- Session
    Session -- Module
    ModuleDatabase -- Module

    class Database {
        str filePath
        loadDatabase()
        saveDatabase()
    }

    class Timetable{
        editSession(id, *)
    }

    class ModuleDatabase {
        editModule(id, *)
    }

    class Session {
        uuid id
        str name
        LocalDate startTime
        LocalDate endTime
        str lecturerName
        str room
        bool mandatory
        str type
        uuid moduleID
    }

    class Module {
        uuid id
        str name
        list[uuid] associatedSessions
    }
